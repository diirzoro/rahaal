# ================================================================
# Rahaal ERP — Environment Variables Template
#
# HOW TO USE:
#   1. Copy this file to `.env` on the Live Server (outside the git repo):
#        cp .env.example /etc/rahaal.env
#   2. Fill in real values.
#   3. NEVER commit the real .env to git.
#   4. Pass the file to Docker at runtime via `--env-file`.
#
# The Rahaal application refuses to start if MONGO_URL or DB_NAME is
# missing — no fallback values are used in application code.
# ================================================================

# --- MongoDB (REQUIRED — no fallback in code) ---
# MongoDB runs directly on the Live Server host (not inside Docker).
# The Rahaal Docker container reaches it through the docker bridge using
# host.docker.internal. This has been verified against the Live Server
# (PING=1, DB_NAME=rahaal, 29 collections).
# MongoDB is intentionally NOT exposed publicly; access is restricted to
# the local Docker bridge/network.
MONGO_URL=mongodb://host.docker.internal:27017

# Canonical Production database name for Rahaal (must be the one that
# holds real Rahaal data — never `your_database_name`, never `targetmedia_db`).
DB_NAME=rahaal

# --- Public URL (used for referral links, official domain) ---
NEXT_PUBLIC_BASE_URL=https://rahaal.targetmediagrp.com

# --- CORS (optional, defaults to '*') ---
# For production, restrict to the exact origin.
CORS_ORIGINS=https://rahaal.targetmediagrp.com

# --- Runtime mode ---
NODE_ENV=production

# --- Internal port that Next.js listens on inside the container ---
# The Docker port publish maps 127.0.0.1:8002 → container:3000
PORT=3000

# --- Production safety: prevent any startup writes to Production data ---
# When 'true' the application will skip seedInitial() entirely:
#   - no super_admin creation
#   - no demo tenant creation
#   - no legacy purge
#   - no automatic index creation
# The application ONLY reads pre-existing Production data.
DISABLE_AUTO_SEED=true

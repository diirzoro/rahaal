{
  "manifest_version": 3,
  "name": "Rahaal Scraper — قارئ رحّال",
  "version": "1.4.0",
  "description": "سحب تلقائي لبيانات التذاكر والتأشيرات إلى نظام رحّال ERP — يدعم PDF + حد التجربة المجانية (30)",
  "action": {
    "default_title": "Rahaal — سحب إلى رحّال",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["parsers.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/pdf.min.mjs", "lib/pdf.worker.min.mjs", "parsers.js"],
      "matches": ["<all_urls>"]
    }
  ]
}

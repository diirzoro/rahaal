# Rahaal production build context: application/build inputs only.
# Dockerfile is still read by Docker; it is not copied by COPY . .
**
!package.json
!yarn.lock
!next.config.js
!postcss.config.js
!tailwind.config.js
!jsconfig.json
!components.json
!app/
!app/**
!components/
!components/**
!hooks/
!hooks/**
!lib/
!lib/**
!public/
!public/**

# Source tests/fixtures remain in Git, never in the production build context.
**/__tests__/
**/__mocks__/
**/*.test.*
**/*.spec.*
public/qa/
public/test/
public/tests/
public/screenshots/
public/debug/

# Exclude local/generated artifacts even inside allowed source directories.
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/.cache/
**/.pytest_cache/
**/__pycache__/
**/coverage/
**/test-results/
**/test_reports/
**/playwright-report/
**/.emergent/
**/*.log
**/*.pyc
**/*.tsbuildinfo
**/*.tmp
**/*.bak
**/.DS_Store
**/*.pem
**/*.key
**/.env
**/.env.*
**/credentials.json
**/.credentials
**/a2.png
**/a3.png
**/a4.jpg

# Exclude incidental archives. This audited archive is an application download,
# read by /api/extension/download; it contains runtime extension files, not QA.
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
!public/rahal-extension.zip
